# Required
TELEGRAM_TOKEN=

# Optional - defaults to sqlite://bot.db
DATABASE_URL=sqlite://bot.db

# Optional - polling interval in seconds (default: 1, supports decimals like 0.5; 0 disables polling)
POLYMARKET_DATA_POLL_SECONDS=1

# Optional - 32-byte hex key for encrypting managed wallet private keys
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# Optional - show the Copy Trade button on trade activity (default: off)
# Set to 1/true/yes to enable. Requires ENCRYPTION_KEY and a managed wallet.
COPY_TRADE_ENABLED=0

# Required for a hosted bot - comma-separated Telegram user IDs allowed to
# use it. Unset or empty LOCKS the bot down; there is no open-access mode.
# Message @userinfobot on Telegram to find your ID.
ALLOWED_TELEGRAM_IDS=

# Required
TELEGRAM_TOKEN=

# Optional - defaults to sqlite://bot.db
DATABASE_URL=sqlite://bot.db

# Optional - polling interval in seconds (default: 1)
POLYMARKET_DATA_POLL_SECONDS=1

# Optional - 32-byte hex key for encrypting managed wallet private keys
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# Optional - for WebSocket user events (your own wallet)
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=
POLYMARKET_ADDRESS=
